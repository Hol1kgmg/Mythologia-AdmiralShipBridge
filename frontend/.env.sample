# Frontend Environment Configuration
DEBUG=true

# Backend API Configuration
# バックエンドAPIのベースURL（開発環境）
API_BASE_URL=http://localhost:8000

# 本番環境の例:
# API_BASE_URL=https://api.yourdomain.com

# Frontend Base URL Configuration
# フロントエンドのベースURL（ステージング・本番環境用）
# 開発環境では自動的にlocalhost:3000が使用されます
NEXT_PUBLIC_FRONTEND_BASE_URL=https://your-domain.com

# その他の環境変数例:
# NEXT_PUBLIC_APP_NAME=Health Check App
# NEXT_PUBLIC_APP_VERSION=1.0.0